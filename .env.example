# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_private_bucket_name

# Razorpay server credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Existing fixed-amount links: Student ₹1,534 and Industry Professional ₹7,080
STUDENT_RAZORPAY_PAYMENT_LINK_URL=https://rzp.io/rzp/replace_with_student_link
STUDENT_RAZORPAY_PAYMENT_LINK_ID=plink_replace_with_student_id
PROFESSIONAL_RAZORPAY_PAYMENT_LINK_URL=https://rzp.io/rzp/replace_with_professional_link
PROFESSIONAL_RAZORPAY_PAYMENT_LINK_ID=plink_replace_with_professional_id

# Set Razorpay webhook endpoint to https://your-domain/api/webhooks/razorpay
# Subscribe to payment_link.paid, payment_link.partially_paid,
# payment_link.expired, payment_link.cancelled, payment.captured,
# payment.failed, refund.created, refund.processed, refund.failed,
# refund.speed_changed

# Auth.js
AUTH_SECRET=generate_a_random_secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_NAME=Conference Administrator
ADMIN_SEED_PASSWORD=

# Public application base URL
APP_BASE_URL=http://localhost:3000

# The configured GST values are not tax advice; confirm GST treatment with the
# organizer's accountant before launch. Apply drizzle/0001_pricing_payment_reconciliation.sql
# to an existing database before deploying code that expects the new columns/tables.
